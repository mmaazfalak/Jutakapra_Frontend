# ==============================================================================
# JUTA.KAPRA FRONTEND - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Backend API Base URL
# In local development: leave empty to use the Vite local proxy (http://localhost:5000)
# In Vercel production: set to your deployed backend URL (e.g. https://jutakapra-backend.vercel.app)
VITE_API_BASE_URL=https://jutakapra-backend.vercel.app

# 2. Supabase Cloud Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# 3. Google OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=682598139720-a1h7nl3vhoisp3rqbugafi98so5ugi8m.apps.googleusercontent.com

# 4. Google Apps Script Webhook Pipeline (Optional fallback for orders & notification emails)
